        "anchor": [
          0,
          13958.3,
          "lt"
        ]
      },
      "text": "without a timeout it just hangs. on NCCL, mismatched calls of the same size\ncan pair up and return wrong numbers instead",
      "originalText": "without a timeout it just hangs. on NCCL, mismatched calls of the same size\ncan pair up and return wrong numbers instead",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
