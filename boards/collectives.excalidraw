      },
      "text": "one line prints, then nothing for 10 s, then every rank times out (tracebacks cut)",
      "originalText": "one line prints, then nothing for 10 s, then every rank times out (tracebacks cut)",
      "fontSize": 28,
      "fontFamily": 5,
