   "customData": {
    "section": "7-bf16",
    "anchor": [
     0,
     8001,
     "lt"
    ]
   },
   "text": "so a step of 0.001 on a weight of 1.0 disappears;\nfp32 gives 0.9990, so the optimizer updates an fp32 copy",
   "originalText": "so a step of 0.001 on a weight of 1.0 disappears;\nfp32 gives 0.9990, so the optimizer updates an fp32 copy",
