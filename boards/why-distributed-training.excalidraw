    "anchor": [
     0,
     7946,
     "lt"
    ]
   },
   "text": "bf16 keeps 8 bits: just below 1.0 its values are 0.0039 apart",
   "originalText": "bf16 keeps 8 bits: just below 1.0 its values are 0.0039 apart",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
